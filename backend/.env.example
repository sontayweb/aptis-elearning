PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/aptis_db?schema=public"

# Authentication JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN=7d

# Gemini AI Key (Lấy từ Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# SMTP Email Service (Nodemailer - Gmail App Password / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aptiskytich.admin@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="APTIS KỲ TÍCH <aptiskytich.admin@gmail.com>"
ADMIN_EMAIL=aptiskytich.admin@gmail.com

