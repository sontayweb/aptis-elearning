{
  "name": "aptis-sync-engine",
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-source Crawler and Sync Engine for Aptis E-learning",
  "scripts": {
    "sync": "node sync.js",
    "sync:all": "node sync.js --source=all",
    "sync:kytich": "node sync.js --source=aptiskytich",
    "sync:academy": "node sync.js --source=aptisacademy",
    "sync:db": "node sync.js --source=all --db",
    "sync:media": "node sync.js --source=aptisacademy --media",
    "list": "node sync.js --list"
  },
  "dependencies": {
    "puppeteer-core": "^23.6.0"
  }
}
