{
  "name": "aptis-kytich-crawler",
  "version": "1.0.0",
  "description": "Tool cào dữ liệu và import tự động từ aptiskytich.vn vào Database Aptis E-learning",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "crawl:all": "tsx src/index.ts --all",
    "crawl:reading": "tsx src/index.ts --skill=reading",
    "crawl:listening": "tsx src/index.ts --skill=listening",
    "crawl:grammar": "tsx src/index.ts --skill=grammar",
    "crawl:dictation": "tsx src/index.ts --skill=dictation",
    "crawl:vocabulary": "tsx src/index.ts --skill=vocabulary",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
